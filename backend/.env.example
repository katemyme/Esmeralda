# Copie este archivo como .env y complete los valores. El .env no se sube a Git.

# development | test | production
NODE_ENV=development

# Puerto HTTP de la API (las rutas quedan bajo /api)
PORT=3000

# Conexión a PostgreSQL: postgres://usuario:contraseña@servidor:puerto/base
# Si la contraseña tiene caracteres especiales, codifíquelos: @ → %40, : → %3A, / → %2F, # → %23
DATABASE_URL=postgres://postgres:CONTRASEÑA@localhost:5432/esmeralda

# Máximo de conexiones simultáneas a PostgreSQL (opcional, por defecto 10)
DB_POOL_MAX=10

# Secreto para firmar los tokens de acceso (JWT). Mínimo 32 caracteres; genere uno con:
#   npm run secreto
# Si cambia, todos deben renovar su acceso (las sesiones siguen valiendo).
JWT_SECRETO=CAMBIE_ESTE_VALOR_POR_EL_QUE_GENERA_npm_run_secreto

# Intentos de login (y de cambio de contraseña) por minuto desde una misma IP (opcional, por defecto 10)
LOGIN_LIMITE_POR_MINUTO=10

# Detrás de un proxy (nginx, Caddy) indique cuántos hay delante o sus IPs, para conocer la IP real
# del cliente: false | true | 1 | loopback | 10.0.0.1 (opcional, por defecto false)
TRUST_PROXY=false

# Carpeta donde se guardan las fotos subidas de productos y mermas (opcional, por defecto almacen/fotos
# dentro de backend/). En el servidor conviene una carpeta fuera del código, incluida en los respaldos.
DIR_FOTOS=almacen/fotos

# Base que las pruebas borran y recrean en cada corrida (opcional; debe terminar en _test).
# Si no se indica, se usa DATABASE_URL con la base esmeralda_api_test.
# TEST_DATABASE_URL=postgres://postgres:CONTRASEÑA@localhost:5432/esmeralda_api_test
