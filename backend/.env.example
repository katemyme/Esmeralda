# Copie este archivo como .env y complete los valores. El .env no se sube a Git.

# development | test | production
NODE_ENV=development

# Puerto HTTP de la API (las rutas quedan bajo /api)
PORT=3000

# Conexión a PostgreSQL: postgres://usuario:contraseña@servidor:puerto/base
# Si la contraseña tiene caracteres especiales, codifíquelos: @ → %40, : → %3A, / → %2F, # → %23
DATABASE_URL=postgres://postgres:CONTRASEÑA@localhost:5432/esmeralda

# Máximo de conexiones simultáneas a PostgreSQL (opcional, por defecto 10)
DB_POOL_MAX=10

# Base que las pruebas borran y recrean en cada corrida (opcional; debe terminar en _test).
# Si no se indica, se usa DATABASE_URL con la base esmeralda_api_test.
# TEST_DATABASE_URL=postgres://postgres:CONTRASEÑA@localhost:5432/esmeralda_api_test
